#!/bin/sh
set -e

[ "$1" = "remove" ] || exit 0

UNITS="ai-memory.service control-tower.service"
usuario="${SUDO_USER:-}"
if [ -n "$usuario" ] && [ "$usuario" != "root" ]; then
  uid="$(id -u "$usuario")"
  # --machine=usuario@ não serve: o systemd corta no primeiro "@", e usuário de domínio
  # (nome@dominio) tem um.
  como_usuario() {
    runuser -u "$usuario" -- env XDG_RUNTIME_DIR="/run/user/$uid" \
      DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" systemctl --user "$@"
  }
  como_usuario stop $UNITS >/dev/null 2>&1 || true
  como_usuario disable $UNITS >/dev/null 2>&1 || true
fi
systemctl --global disable $UNITS >/dev/null 2>&1 || true
pkill -f /opt/control-tower/ >/dev/null 2>&1 || true
